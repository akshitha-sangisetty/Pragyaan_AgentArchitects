# LLM Provider Configuration
# Options: "groq" (default for live demo), "gemini", or "demo" (deterministic scenario mode)
LLM_PROVIDER=groq

# Groq Configuration (Qwen 2.5 on Groq LPUs)
# Free key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen-2.5-32b

# Google Gemini Configuration (Backup)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Server Configuration
HOST=0.0.0.0
PORT=8000
